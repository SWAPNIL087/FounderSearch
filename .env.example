# Copy to .env (setup.py does this for you) and fill in. Never commit .env.

# --- Gmail (reads F5Bot alert emails) -------------------------------------
# Use a dedicated Gmail account for F5Bot. See SETUP.md, step 3.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=yfvx nnbo bcxb hdho         # 16-character Google "app password", not your login password

# --- LLM used to classify items (any OpenAI-compatible endpoint) ------------
# Leave LLM_API_KEY empty to run with the built-in keyword scorer only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only for Azure OpenAI (base URL = https://<resource>.openai.azure.com/openai/deployments/<deployment>)
LLM_API_VERSION=2024-06-01

# --- Optional sources ----------------------------------------------------
GITHUB_TOKEN=           # raises GitHub search limit; no scopes needed
STACKEXCHANGE_KEY=      # raises Stack Exchange quota
REDDIT_CLIENT_ID=       # only if Reddit approves a "script" app for you
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=foundersearch/0.1 by u/your_reddit_username

# --- App -----------------------------------------------------------------
# SIGNALBOARD_DB=data/foundersearch.db
# SIGNALBOARD_CONFIG=config.yaml
